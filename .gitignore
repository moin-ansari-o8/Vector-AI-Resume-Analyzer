# ==========================================
# Root .gitignore for AI-Resume-Analyzer
# ==========================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
venv*/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/

# Pytest / Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/
dist-ssr/
*.local

# --- Environment Files ---
.env
.env.local
.env.*.local

# --- Data & User Uploads ---
backend/uploads/*
!backend/uploads/.gitkeep
vector_db/*
!vector_db/.gitkeep

# SQLite & Databases
*.sqlite
*.sqlite3
*.db
backend/data/*.db
backend/data/raw/

# --- Logs ---
logs/
*.log

# --- OS & IDE Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
